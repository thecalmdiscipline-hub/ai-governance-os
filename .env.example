# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-audit-secret-here

# Database
DATABASE_URL=postgresql://user:password@localhost/valqeron

# Redis (used for rate limiting; required in production)
REDIS_URL=redis://localhost:6379

# OpenAI (used by LLM workflow implementations)
OPENAI_API_KEY=sk-...

# Deployment environment — set to "production" in production deployments.
# In production, Redis must be reachable or startup will fail.
ENVIRONMENT=development

# CORS — comma-separated list of allowed origins (optional, defaults to Valqeron domains + localhost)
ALLOWED_ORIGINS=https://app.valqeron.com,https://compliance.valqeron.com

# Valqeron HQ ("tenant 0") organization id — leave empty/unset until the HQ
# organization is set up. Must be a positive integer (organizations.id).
HQ_ORGANIZATION_ID=

# Sentry error reporting (errors only, no customer content). Leave empty for dev/tests:
# nothing is sent without a DSN. The real backend DSN only goes in the production .env.
SENTRY_DSN=

# Fernet key that encrypts users' TOTP secrets (NOT the same as SECRET_KEY). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it MFA enrollment refuses; the rest of the app keeps working. If this key is lost, all
# stored MFA secrets become unusable: use scripts/mfa_reset.py per user (see CLAUDE.md, sectie 6).
MFA_ENCRYPTION_KEY=
