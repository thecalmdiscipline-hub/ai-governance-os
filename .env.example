# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# Database
DATABASE_URL=postgresql://user:password@localhost/valqeron

# Redis (used for rate limiting)
REDIS_URL=redis://localhost:6379

# OpenAI (used by LLM workflow implementations)
OPENAI_API_KEY=sk-...

# CORS — comma-separated list of allowed origins (optional, defaults to Valqeron domains + localhost)
ALLOWED_ORIGINS=https://app.valqeron.com,https://compliance.valqeron.com
