# =============================================================================
# valqeron.service — systemd unit for the Valqeron FastAPI app
#
# Install: cp systemd/valqeron.service /etc/systemd/system/valqeron.service
#          systemctl daemon-reload && systemctl enable --now valqeron
#
# Logs:    journalctl -u valqeron -f
# Status:  systemctl status valqeron
# =============================================================================

[Unit]
Description=Valqeron AI Governance OS
Documentation=https://github.com/thecalmdiscipline-hub/ai-governance-os
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data

WorkingDirectory=/opt/valqeron
EnvironmentFile=/opt/valqeron/.env

# One worker on purpose: the droplet has 1 vCPU and ~2 GB RAM, so a second
# worker only doubles the ~1.5 GB spaCy footprint. With --workers 1 uvicorn
# runs the server directly (no supervisor), so --timeout-worker-healthcheck
# is inert; it is kept as a safety net should --workers ever go back to >1
# (the supervisor's default 5 s healthcheck killed workers during the model
# load). The PII models are warmed up at startup via PII_WARMUP_ON_STARTUP=1
# in /opt/valqeron/.env, which makes the start take ~20-40 s.
ExecStart=/opt/valqeron/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --timeout-worker-healthcheck 60 \
    --log-level info \
    --access-log \
    --no-use-colors

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=valqeron

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/valqeron

[Install]
WantedBy=multi-user.target
